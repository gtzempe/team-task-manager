      "credentials": [
        {
          "type": "password",
          "value": "assigner",
          "temporary": false
        }
      ],
      "realmRoles": [
        "assigner"
      ]
    },
    {
      "username": "assignee1",
      "enabled": true,
      "firstName": "Assignee",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "assignee1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "assignee"
      ]
    },
    {
      "username": "assignee2",
      "enabled": true,
      "firstName": "Assignee",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "assignee2",
          "temporary": false
        }
      ],
      "realmRoles": [
        "assignee"
      ]
    },
    {
      "username": "service-account-task-manager-backend",
      "enabled": true,
      "serviceAccountClientId": "task-manager-backend",
